package fileHandling.file;

import java.io.File;

public class Program1 {

	public static void main(String[] args) {
		File f1 = new File("fileWriter2");
		try {
			System.out.println(f1.length());
		} catch (Exception e) {
			System.out.println(e);
			System.out.println(e.getMessage());
		}

	}

}
